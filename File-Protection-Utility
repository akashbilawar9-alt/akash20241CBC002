from cryptography.fernet import Fernet
import os

KEY_FILE = "secret.key"


# Generate a key if one does not already exist
def generate_key():
    if not os.path.exists(KEY_FILE):
        key = Fernet.generate_key()

        with open(KEY_FILE, "wb") as file:
            file.write(key)

        print("Encryption key created successfully.")


# Load the saved key
def load_key():
    with open(KEY_FILE, "rb") as file:
        return file.read()


# Protect (encrypt) the file
def protect_file(filename):
    key = load_key()
    fernet = Fernet(key)

    with open(filename, "rb") as file:
        data = file.read()

    encrypted_data = fernet.encrypt(data)

    with open(filename + ".protected", "wb") as file:
        file.write(encrypted_data)

    print("File protected successfully.")


# Restore (decrypt) the file
def restore_file(filename):
    key = load_key()
    fernet = Fernet(key)

    with open(filename, "rb") as file:
        encrypted_data = file.read()

    decrypted_data = fernet.decrypt(encrypted_data)

    output_file = filename.replace(".protected", ".restored")

    with open(output_file, "wb") as file:
        file.write(decrypted_data)

    print("File restored successfully.")


# Main program
generate_key()

print("\n=== File Protection Utility ===")
print("1. Protect File")
print("2. Restore File")

choice = input("Enter your choice: ")

filename = input("Enter file name: ")

try:
    if choice == "1":
        protect_file(filename)

    elif choice == "2":
        restore_file(filename)

    else:
        print("Invalid choice.")

except FileNotFoundError:
    print("Error: File not found.")

except Exception:
    print("Error: Invalid file or incorrect protection key.")
